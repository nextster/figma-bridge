{
  "name": "figma-bridge",
  "version": "0.2.0",
  "description": "Bidirectional bridge between AI coding agents and open Figma files, locally or through a relay.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm --prefix figma-plugin run build",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"companion/test/*.test.mjs\" \"runtime/*.test.mjs\" \"plugins/figma-bridge/test/*.test.mjs\" \"relay/test/*.test.mjs\" && npm --prefix figma-plugin test",
    "verify": "npm run check && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "uninstall": "node scripts/setup.mjs --uninstall",
    "bridge": "node companion/src/cli.mjs",
    "live:verify": "node scripts/live-verify.mjs",
    "dev:link": "node scripts/dev.mjs link",
    "dev:status": "node scripts/dev.mjs status",
    "dev:unlink": "node scripts/dev.mjs unlink",
    "relay": "node --disable-warning=ExperimentalWarning relay/src/main.mjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
